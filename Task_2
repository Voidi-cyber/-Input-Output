using System;

class Program
{
    static void Main()
    {
        Console.Write("Введіть висоту трикутника: ");
        int h = int.Parse(Console.ReadLine());

        for (int i = 1; i <= h; i++)
        {
            for (int s = 0; s < h - i; s++)
                Console.Write(" ");

            for (int j = 0; j < i; j++)
                Console.Write(i + " ");

            Console.WriteLine();
        }
    }
}
